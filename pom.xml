<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.jwetherell</groupId>
  <artifactId>java-algorithms-implementation</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>Java : Algorithms and Data Structure</name>
  <description>Algorithms and Data Structures implemented in Java</description>
  <url>https://github.com/phishman3579/java-algorithms-implementation</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>phishman3579</id>
      <name>Justin Wetherell</name>
      <email>phishman3579@gmail.com</email>
    </developer>
  </developers>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Java 25 is the current LTS. Java 27, the latest feature release, also builds and
         tests clean (see .github/workflows/ci.yml). -->
    <maven.compiler.release>25</maven.compiler.release>
    <junit.version>6.1.3</junit.version>

    <!-- Overridden by the benchmark-* profiles below. -->
    <benchmark.mainClass>com.jwetherell.algorithms.sorts.timing.SortsTiming</benchmark.mainClass>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Keep the historical src/ and test/ layout so existing links and history stay valid. -->
    <sourceDirectory>${project.basedir}/src</sourceDirectory>
    <testSourceDirectory>${project.basedir}/test</testSourceDirectory>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:all,-serial</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <!-- Mirrors the historical Ant batchtest pattern: run every class in a **/test/
               package, but not the shared helpers in **/test/common/. -->
          <includes>
            <include>**/test/*.java</include>
          </includes>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>com.jwetherell.algorithms</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>

      <!-- Replaces the historical `ant <name>` benchmark targets. Forks a separate JVM so
           that the timings are not distorted by Maven's own JVM. Run, for example:
             mvn -Pbenchmark-sorts test-compile exec:exec -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <executable>java</executable>
          <!-- The harnesses live in test/, so the test classpath is required. -->
          <classpathScope>test</classpathScope>
          <arguments>
            <argument>-server</argument>
            <argument>-Xmx3g</argument>
            <argument>-classpath</argument>
            <classpath/>
            <argument>${benchmark.mainClass}</argument>
          </arguments>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>benchmark-sorts</id>
      <properties>
        <benchmark.mainClass>com.jwetherell.algorithms.sorts.timing.SortsTiming</benchmark.mainClass>
      </properties>
    </profile>
    <profile>
      <id>benchmark-data_structures</id>
      <properties>
        <benchmark.mainClass>com.jwetherell.algorithms.data_structures.timing.DataStructuresTiming</benchmark.mainClass>
      </properties>
    </profile>
    <profile>
      <id>benchmark-spatial_data_structures</id>
      <properties>
        <benchmark.mainClass>com.jwetherell.algorithms.data_structures.timing.SpatialDataStructuresTiming</benchmark.mainClass>
      </properties>
    </profile>
    <profile>
      <id>benchmark-mathematics</id>
      <properties>
        <benchmark.mainClass>com.jwetherell.algorithms.mathematics.timing.MathematicsTiming</benchmark.mainClass>
      </properties>
    </profile>
    <profile>
      <id>benchmark-numbers</id>
      <properties>
        <benchmark.mainClass>com.jwetherell.algorithms.numbers.timing.NumbersTiming</benchmark.mainClass>
      </properties>
    </profile>
    <profile>
      <id>benchmark-search</id>
      <properties>
        <benchmark.mainClass>com.jwetherell.algorithms.search.timing.SearchTiming</benchmark.mainClass>
      </properties>
    </profile>
    <profile>
      <id>benchmark-sequences</id>
      <properties>
        <benchmark.mainClass>com.jwetherell.algorithms.sequence.timing.SequencesTiming</benchmark.mainClass>
      </properties>
    </profile>
    <profile>
      <id>benchmark-strings</id>
      <properties>
        <benchmark.mainClass>com.jwetherell.algorithms.strings.timing.StringsTiming</benchmark.mainClass>
      </properties>
    </profile>
  </profiles>
</project>
